{"kind":"textbox","id":"sh/ed8z2poj","slide":2,"text":"UDYAAN / SECRET PROJECT","textPreview":"UDYAAN / SECRET PROJECT","textChars":23,"textLines":1,"bbox":[910,34,300,22]}
