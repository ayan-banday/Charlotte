{"kind":"textbox","id":"sh/0fqh4z6p","slide":2,"text":"02","textPreview":"02","textChars":2,"textLines":1,"bbox":[1170,674,42,18]}
{"kind":"textbox","id":"sh/1gzid47a","slide":2,"text":"A small side project inside Udyaan","textPreview":"A small side project inside Udyaan","textChars":34,"textLines":1,"bbox":[64,83,820,78]}
{"kind":"textbox","id":"sh/uh4zq5of","slide":2,"text":"It adds a playable layer around a serious course.","textPreview":"It adds a playable layer around a serious course.","textChars":49,"textLines":1,"bbox":[64,166,760,44]}
{"kind":"shape","id":"sh/fidgzap0","slide":2,"bbox":[64,235,520,280]}
{"kind":"textbox","id":"sh/z65wju9k","slide":2,"text":"The course teaches students how to take an idea and turn it into a real business.","textPreview":"The course teaches students how to take an idea and turn it into a real business.","textChars":81,"textLines":1,"bbox":[94,270,440,76]}
{"kind":"textbox","id":"sh/y5wfap8z","slide":2,"text":"The playable layer helps them see where they are, understand what to do next, and keep moving when the work becomes uncomfortable.","textPreview":"The playable layer helps them see where they are, understand what to do next, and keep moving when the work becomes uncomfortable.","textChars":130,"textLines":1,"bbox":[94,372,440,100]}
