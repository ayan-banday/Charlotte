{"kind":"textbox","id":"sh/i5gfyhs7","slide":1,"text":"A playable layer\nfor a course about\nbuilding a business","textPreview":"A playable layer | for a course about | building a business","textChars":55,"textLines":3,"bbox":[92,125,500,175]}
