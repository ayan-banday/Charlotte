{"kind":"textbox","id":"sh/4v6twnmt","slide":3,"text":"UDYAAN / SECRET PROJECT","textPreview":"UDYAAN / SECRET PROJECT","textChars":23,"textLines":1,"bbox":[910,34,300,22]}
{"kind":"shape","id":"sh/pwfapsne","slide":3,"bbox":[64,62,1152,0]}
{"kind":"textbox","id":"sh/2tobux4n","slide":3,"text":"03","textPreview":"03","textChars":2,"textLines":1,"bbox":[1170,674,42,18]}
{"kind":"textbox","id":"sh/3uxsn258","slide":3,"text":"Students move through three practical stages","textPreview":"Students move through three practical stages","textChars":44,"textLines":1,"bbox":[64,83,820,78]}
{"kind":"textbox","id":"sh/orat8rmx","slide":3,"text":"Each stage answers a question they need to answer before they can build a real business.","textPreview":"Each stage answers a question they need to answer before they can build a real business.","textChars":88,"textLines":1,"bbox":[64,166,760,44]}
{"kind":"shape","id":"sh/9sju1w3i","slide":3,"bbox":[64,270,235,165]}
{"kind":"textbox","id":"sh/t47qhcne","slide":3,"text":"01","textPreview":"01","textChars":2,"textLines":1,"bbox":[82,286,45,24]}
{"kind":"textbox","id":"sh/sjyp8r6t","slide":3,"text":"Understand the business","textPreview":"Understand the business","textChars":23,"textLines":1,"bbox":[82,323,195,34]}
{"kind":"textbox","id":"sh/7ip8fm58","slide":3,"text":"Who is this for? What problem do they have?","textPreview":"Who is this for? What problem do they have?","textChars":43,"textLines":1,"bbox":[82,372,195,43]}
{"kind":"textbox","id":"sh/6hg76hon","slide":3,"text":"→","textPreview":"→","textChars":1,"textLines":1,"bbox":[302,323,42,42]}
{"kind":"shape","id":"sh/5gnqdcn2","slide":3,"bbox":[448,270,235,165]}
{"kind":"textbox","id":"sh/kfep476h","slide":3,"text":"02","textPreview":"02","textChars":2,"textLines":1,"bbox":[466,286,45,24]}
{"kind":"textbox","id":"sh/je58b25w","slide":3,"text":"Build a first version","textPreview":"Build a first version","textChars":21,"textLines":1,"bbox":[466,323,195,34]}
{"kind":"textbox","id":"sh/idw72xob","slide":3,"text":"What are we offering? How will it help?","textPreview":"What are we offering? How will it help?","textChars":39,"textLines":1,"bbox":[466,372,195,43]}
{"kind":"textbox","id":"sh/pcrqpgn6","slide":3,"text":"→","textPreview":"→","textChars":1,"textLines":1,"bbox":[686,323,42,42]}
{"kind":"shape","id":"sh/obi9gb61","slide":3,"bbox":[832,270,235,165]}
{"kind":"textbox","id":"sh/ofq9sfux","slide":3,"text":"03","textPreview":"03","textChars":2,"textLines":1,"bbox":[850,286,45,24]}
{"kind":"textbox","id":"sh/9gzalkvi","slide":3,"text":"Test it with people","textPreview":"Test it with people","textChars":19,"textLines":1,"bbox":[850,323,195,34]}
{"kind":"textbox","id":"sh/md8rq5cr","slide":3,"text":"What happens when real people see it?","textPreview":"What happens when real people see it?","textChars":37,"textLines":1,"bbox":[850,372,195,43]}
